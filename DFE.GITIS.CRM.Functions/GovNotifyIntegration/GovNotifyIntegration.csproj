<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <AzureFunctionsVersion>v3</AzureFunctionsVersion>
    <UserSecretsId>4b674f2f-30d7-44bb-bc29-d81edb34f044</UserSecretsId>
    <AssemblyName>DFE.GITIS.CRM.Functions.GovNotifyIntegration</AssemblyName>
